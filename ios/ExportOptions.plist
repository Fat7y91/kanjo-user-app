<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>method</key>
    <string>ad-hoc</string>
    <!-- Change to 'app-store' for App Store distribution -->
    <!-- Change to 'enterprise' for Enterprise distribution -->
    <!-- Change to 'development' for Development distribution -->
    
    <key>teamID</key>
    <string>YOUR_TEAM_ID</string>
    <!-- Replace with your Apple Developer Team ID -->
    
    <key>compileBitcode</key>
    <false/>
    
    <key>uploadBitcode</key>
    <false/>
    
    <key>uploadSymbols</key>
    <true/>
    
    <key>signingStyle</key>
    <string>manual</string>
    
    <key>provisioningProfiles</key>
    <dict>
        <key>com.qeema.heraj</key>
        <string>YOUR_PROVISIONING_PROFILE_NAME</string>
        <!-- Replace with your Bundle ID and Provisioning Profile Name -->
    </dict>
    
    <key>signingCertificate</key>
    <string>iPhone Distribution</string>
    <!-- Change to 'iPhone Developer' for development builds -->
    
    <key>stripSwiftSymbols</key>
    <true/>
    
    <key>thinning</key>
    <string>&lt;none&gt;</string>
</dict>
</plist>

